---
import { defaultLocale, locales } from '../i18n'

const fallback = defaultLocale
---

<!doctype html>
<html lang="zh">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#efeee9" />
    <title>SEED</title>
    <noscript><meta http-equiv="refresh" content={`0;url=/${fallback}/`} /></noscript>
    <script is:inline define:vars={{ locales, fallback }}>
      const language = (navigator.languages?.[0] || navigator.language || '').toLowerCase().split('-')[0]
      const target = locales.includes(language) ? language : fallback
      location.replace(`/${target}/`)
    </script>
  </head>
  <body>
    <a href={`/${fallback}/`}>SEED →</a>
  </body>
</html>

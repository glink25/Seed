---
import Home from '../../components/Home.astro'
import { locales, translations, type Copy, type Locale } from '../../i18n'

export function getStaticPaths() {
  return locales.map((lang) => ({
    params: { lang },
    props: { lang, copy: translations[lang] },
  }))
}

const { lang, copy } = Astro.props as { lang: Locale; copy: Copy }
---

<Home lang={lang} copy={copy} />

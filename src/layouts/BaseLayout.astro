---
import '../styles.css'
import type { Locale } from '../i18n'

interface Props {
  lang: Locale
  title: string
  description: string
}

const { lang, title, description } = Astro.props
const alternateLocale = lang === 'zh' ? 'en' : 'zh'
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#efeee9" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="SEED" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="alternate" hreflang={lang} href={`/${lang}/`} />
    <link rel="alternate" hreflang={alternateLocale} href={`/${alternateLocale}/`} />
    <link rel="alternate" hreflang="x-default" href="/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
